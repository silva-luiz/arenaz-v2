{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["API_URL"]
    },
    "@arenaz/web#build": {
      "dependsOn": ["^build", "@arenaz/web#typecheck"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["API_URL"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL"]
    },
    "e2e": {
      "dependsOn": ["^build", "@arenaz/api#build"],
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL",
        "REDIS_URL",
        "BETTER_AUTH_SECRET",
        "CI",
        "E2E_WEB_PORT",
        "E2E_API_PORT",
        "GEO_PROVIDER",
        "PAYMENT_PROVIDER",
        "S3_ENDPOINT",
        "S3_REGION",
        "S3_BUCKET",
        "S3_ACCESS_KEY_ID",
        "S3_SECRET_ACCESS_KEY",
        "S3_PUBLIC_URL",
        "S3_FORCE_PATH_STYLE"
      ]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
