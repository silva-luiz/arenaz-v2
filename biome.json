{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/pnpm-lock.yaml",
      "!docs/design/prototipo",
      "!**/.env.example",
      "!apps/web/e2e/playwright-report",
      "!apps/web/e2e/test-results",
      "!packages/db/migrations/meta"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "auto"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always",
      "bracketSpacing": true
    },
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "html": {
    "formatter": {
      "enabled": false
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": "off",
      "complexity": {
        "noBannedTypes": "error",
        "noUselessTypeConstraint": "error",
        "noUselessThisAlias": "error",
        "useOptionalChain": "off"
      },
      "correctness": {
        "noUnusedFunctionParameters": "off"
      },
      "style": {
        "noCommonJs": "error",
        "noNamespace": "error",
        "noNonNullAssertion": "error",
        "useArrayLiterals": "error",
        "useAsConstAssertion": "error",
        "useConsistentEnumValueType": "error",
        "useImportType": "off",
        "useLiteralEnumMembers": "error",
        "useThrowOnlyError": "error",
        "useUnifiedTypeSignatures": "error"
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noAssignInExpressions": "off",
        "noConfusingVoidType": "error",
        "noDeprecatedImports": "error",
        "noEmptyBlockStatements": "error",
        "noExplicitAny": "error",
        "noFocusedTests": "off",
        "noTsIgnore": "error"
      },
      "nursery": {
        "noBaseToString": "error",
        "noFloatingPromises": "error",
        "noMeaninglessVoidOperator": "error",
        "noMisusedPromises": "error",
        "noUnnecessaryTemplateExpression": "error",
        "noUnsafePlusOperands": "error",
        "usePromiseRejectErrors": "error",
        "useReduceTypeParameter": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.{js,mjs,cjs}"],
      "linter": {
        "rules": {
          "nursery": {
            "noBaseToString": "off",
            "noFloatingPromises": "off",
            "noMisusedPromises": "off",
            "noUnsafePlusOperands": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.test.{ts,tsx}", "**/test/**", "**/e2e/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noFocusedTests": "error"
          }
        }
      }
    },
    {
      "includes": ["apps/api/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noStaticOnlyClass": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/**", "packages/ui/**"],
      "linter": {
        "domains": {
          "react": "recommended"
        }
      }
    },
    {
      "includes": ["apps/web/**"],
      "linter": {
        "domains": {
          "next": "recommended"
        }
      }
    }
  ]
}
