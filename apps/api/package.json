{
  "name": "@arenaz/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node scripts/dev.mjs",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "demo:seed": "node --env-file-if-exists=../../.env scripts/demo-seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@arenaz/booking-core": "workspace:*",
    "@arenaz/contracts": "workspace:*",
    "@arenaz/db": "workspace:*",
    "@aws-sdk/client-s3": "^3.1158.0",
    "@aws-sdk/s3-presigned-post": "^3.1158.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-fastify": "^12.3.2",
    "better-auth": "^1.7.14",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uqr": "0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@arenaz/config": "workspace:*",
    "@swc/core": "^1.16.20",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "testcontainers": "^12.2.1",
    "typescript": "^6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
