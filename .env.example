# Copy to .env (never commit .env):  cp .env.example .env

DATABASE_URL=postgres://arenaz:arenaz@localhost:5432/arenaz
REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

API_PORT=4000
API_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

# Public origin of the site (base for OpenGraph and canonical URLs). Inlined at
# build time; set it to the real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Object storage for photos: MinIO from `pnpm db:up` (local credentials only).
# S3_PUBLIC_URL is the browser-facing base URL of the bucket's objects.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=arenaz-photos
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9000/arenaz-photos
S3_FORCE_PATH_STYLE=true

# CEP lookup: `http` (ViaCEP + Nominatim) or `fake` (fixed table, no network).
# `fake` is for tests and e2e only; the API refuses it with NODE_ENV=production.
GEO_PROVIDER=http

# Optional shared secret (min 32 chars) for server-to-server calls: the web's
# SSR sends it as `x-internal-token` and skips the API rate limits, since all
# its requests come from one IP. Server-side only: never expose it to the
# browser (no NEXT_PUBLIC_ prefix). Leave empty to turn the feature off.
# Generate with: openssl rand -base64 32
#   (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
INTERNAL_API_TOKEN=
